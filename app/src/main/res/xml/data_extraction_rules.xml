<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Every workspace has its own midas*.db and datastore/settings*.preferences_pb. -->
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
        <include domain="sharedpref" path="workspaces.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
        <include domain="sharedpref" path="workspaces.xml" />
    </device-transfer>
</data-extraction-rules>
